# --- Required ---------------------------------------------------------------
# Neon/Supabase Postgres. DATABASE_URL can be the pooled URL; DIRECT_URL must be
# the direct (non-pooled) URL - Prisma uses it for migrations.
DATABASE_URL="postgresql://user:pass@host:5432/linkable"
DIRECT_URL="postgresql://user:pass@host:5432/linkable"

# Auth.js session signing key: `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=""

# 32-byte key (64 hex chars) that encrypts 2FA secrets: `openssl rand -hex 32`
# Never change it after launch, or existing 2FA setups stop working.
ENCRYPTION_KEY=""

# Public URL of the app, used in email links. No trailing slash.
APP_URL="http://localhost:3000"

# Comma-separated emails that become platform admins on signup.
PLATFORM_ADMIN_EMAILS="sujitk@solguruz.com"

# --- Optional ---------------------------------------------------------------
# Google sign-in. Redirect URI to register: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (Resend). Without a key, emails are printed to the server log instead.
RESEND_API_KEY=""
EMAIL_FROM="Linkable <no-reply@your-domain.com>"

# SEO metrics provider (used from Phase 1).
AHREFS_API_KEY=""
